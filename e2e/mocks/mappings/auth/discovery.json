{
  "request": { "method": "GET", "url": "/auth/.well-known/openid-configuration" },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "issuer": "http://external-mocks:8080/auth",
      "authorization_endpoint": "http://external-mocks:8080/auth/authorize",
      "token_endpoint": "http://external-mocks:8080/auth/token",
      "jwks_uri": "http://external-mocks:8080/auth/jwks",
      "userinfo_endpoint": "http://external-mocks:8080/auth/userinfo",
      "end_session_endpoint": "http://localhost:8080/login?logout",
      "response_types_supported": ["code", "id_token"],
      "subject_types_supported": ["public"],
      "id_token_signing_alg_values_supported": ["RS256"],
      "scopes_supported": ["openid", "profile", "email"],
      "token_endpoint_auth_methods_supported": ["client_secret_basic", "client_secret_post"],
      "claims_supported": ["sub", "iss", "aud", "exp", "iat", "name", "email"]
    }
  }
}